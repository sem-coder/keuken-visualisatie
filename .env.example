# OpenAI (server-side only)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1.5
# Kwaliteit: high + high voor correcte voor/na-vergelijking; medium kan uitsnede verschuiven
OPENAI_IMAGE_QUALITY=high
OPENAI_INPUT_FIDELITY=high

# Kosteninschatting (optioneel, USD)
# OPENAI_INPUT_COST_PER_1M_USD=5
# OPENAI_OUTPUT_COST_PER_1M_USD=40
# OPENAI_IMAGE_FLAT_COST_USD=0.12
# OPENAI_IMAGE_FALLBACK_COST_USD=0.12

# Admin dashboard (/admin) en klantportaal (/portal)
ADMIN_PASSWORD=

# Publieke app-URL (voor embed-codes in admin)
NEXT_PUBLIC_APP_URL=https://keuken-visualisatie-tool.vercel.app

# Webflow embed
NEXT_PUBLIC_PARENT_ORIGIN=https://www.jouwwebsite.nl
NEXT_PUBLIC_PARENT_WEBSITE_URL=https://www.jouwwebsite.nl

# Toon "gratis" bij samples (true/false)
NEXT_PUBLIC_SHOW_FREE_SAMPLES=true

# Optionele webhook voor sample-aanvragen
SAMPLE_WEBHOOK_URL=

# E-mail voor wachtwoord-reset (Gmail Workspace)
GMAIL_WORKSPACE_USER=ai@woeler.nl
GMAIL_WORKSPACE_APP_PASSWORD=

# Analytics opslag (optioneel, default: data/analytics.json lokaal, /tmp op Vercel)
# ANALYTICS_STORE_PATH=/pad/naar/analytics.json
